# OnyxVision Environment Configuration Template
# Copy this file to backend/.env or .env and configure your custom settings

# Server Host & Port Configuration
ONYX_HOST=0.0.0.0
ONYX_PORT=8000

# TMDB (The Movie Database) API v3 Key for automatic poster and metadata scraping
# Obtain your free API key at: https://www.themoviedb.org/settings/api
ONYX_TMDB_API_KEY=your_tmdb_api_key_here

# Emby / Jellyfin / WebDAV Defaults (Optional)
# EMBY_DEFAULT_URL=http://192.168.1.100:8096
# EMBY_DEFAULT_API_KEY=your_emby_api_key
